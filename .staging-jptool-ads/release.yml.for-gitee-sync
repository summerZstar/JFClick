# 疾风自动点击 JFClick —— 构建 + 双平台 Release 自动发布
#
# 触发：push 到 main（仅构建、传 artifact）或 push v* 标签（构建 + GitHub Release + 同步 Gitee Release）。
#
# 说明：本文件是 JFClick-src/.github/workflows/release.yml 的「Gitee 关联版」。
#       相比原版新增了末尾的 "Sync release to Gitee" 步骤，用于在打 tag 时，
#       把构建好的 JFClick.exe 通过 Gitee 开放 API 自动上传到 gitee.com/8snow/JFClick 的 Release，
#       实现一次操作、GitHub 与 Gitee 同步发布，无需手动传两次。

name: Build JFClick

on:
  push:
    branches:
      - main
    tags:
      - 'v*'

permissions:
  contents: write

jobs:
  build:
    runs-on: windows-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v5

      - name: Setup MSYS2
        uses: msys2/setup-msys2@v2
        with:
          msystem: MINGW64
          update: true
          install: >-
            mingw-w64-x86_64-gcc
            mingw-w64-x86_64-binutils

      - name: Build
        shell: msys2 {0}
        run: |
          cd src
          windres -c 65001 resource.rc -O coff -o resource.o
          g++ -mwindows -std=c++20 -O2 -static -finput-charset=UTF-8 -fwide-exec-charset=UTF-16LE -o ../JFClick.exe main.cpp engine.cpp resource.o -lgdi32 -lcomctl32 -lshell32 -ladvapi32 -lwinhttp

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: JFClick
          path: JFClick.exe

      - name: Release (GitHub)
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v2
        with:
          files: JFClick.exe
          generate_release_notes: true

      # =====================================================================
      # Gitee 联动：把同一个 v* 标签对应的 JFClick.exe 也发布到 Gitee 的 Release
      # 依赖：仓库里配置 Actions secret，名称为 GITEE_TOKEN（Gitee 个人令牌，含 projects 权限）
      # =====================================================================
      - name: Sync release to Gitee
        if: startsWith(github.ref, 'refs/tags/')
        shell: bash
        env:
          GITEE_TOKEN: ${{ secrets.GITEE_TOKEN }}
          GITEE_OWNER: 8snow
          GITEE_REPO: JFClick
        run: |
          set -e
          TAG="${GITHUB_REF#refs/tags/}"
          API_BASE="https://gitee.com/api/v5/repos/${GITEE_OWNER}/${GITEE_REPO}"

          # 1) 尝试获取该 tag 已存在的 Gitee Release；不存在则创建
          RID=$(curl -s "${API_BASE}/releases/tags/${TAG}?access_token=${GITEE_TOKEN}" \
            | python -c "import sys,json
try:
    d=json.load(sys.stdin); print(d.get('id',''))
except Exception:
    print('')")

          if [ -z "$RID" ]; then
            echo "Gitee release ${TAG} 不存在，创建中..."
            RESP=$(curl -s -X POST "${API_BASE}/releases" \
              -H "Content-Type: application/json" \
              -d "{\"access_token\":\"${GITEE_TOKEN}\",\"tag_name\":\"${TAG}\",\"target_commitish\":\"master\",\"name\":\"${TAG}\",\"body\":\"JFClick ${TAG}\"}")
            RID=$(echo "$RESP" | python -c "import sys,json
try:
    d=json.load(sys.stdin); print(d.get('id',''))
except Exception:
    print('')")
            if [ -z "$RID" ]; then
              echo "创建 Gitee Release 失败：$RESP"; exit 1
            fi
          fi

          # 2) 上传 JFClick.exe 附件到该 Gitee Release
          echo "上传 JFClick.exe 到 Gitee release id=${RID} ..."
          curl -s -X POST "${API_BASE}/releases/${RID}/attach_files" \
            -F "access_token=${GITEE_TOKEN}" \
            -F "file=@JFClick.exe"

          echo "Gitee 同步完成：https://gitee.com/${GITEE_OWNER}/${GITEE_REPO}/releases/tag/${TAG}"